# Development defaults. Never reuse these example values in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_EXP_MINUTES=480
JWT_ISSUER=revnivo-api
JWT_AUDIENCE=revnivo-web

# Explicit admin bootstrap. The matching account must already exist.
SUPERADMIN_EMAIL=

# Cookie/session settings.
AUTH_COOKIE_NAME=revnivo_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Production host/origin settings.
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=revnivo

EGP_PER_USD=50.00
EGP_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EGP_RATE_CACHE_SECONDS=3600

API_BURST_RATE=120/min
API_SUSTAINED_RATE=150000/day

DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152

# SMTP email delivery. For Gmail, use a Google App Password, not your sign-in password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-email@example.com
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Paymob Unified Checkout.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_CURRENCY=EGP

# In production these should use public HTTPS URLs.
PAYMOB_WEBHOOK_URL=
PAYMOB_REDIRECT_URL=http://localhost:5173/payments?provider=paymob

# Cloudinary remote media storage.
# Leave CLOUDINARY_URL blank to keep using backend/media + backend/private_media locally.
# Copy the API environment variable from your Cloudinary product environment.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=revnivo
CLOUDINARY_PRIVATE_URL_TTL=300
