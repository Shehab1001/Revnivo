# Local development: leave blank to use Vite's same-origin /api proxy.
# Netlify production: also leave VITE_API_URL unset/blank. The repository's
# netlify.toml proxies /api and /media to the Render backend.
# Only set this when intentionally calling a backend directly from the browser.
VITE_API_URL=

# Use the same OAuth Web client ID as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
